{
  "name": "great-boardgame-getaway",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "generate:session-secret": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('hex'))\"",
